<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-maccatalyst;net10.0-ios</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
		<UseMaui>false</UseMaui>
    <RootNamespace>ILNumerics.Community.MAUI</RootNamespace>
    <AssemblyName>ILNumerics.Community.MAUI</AssemblyName>
    <AssemblyVersion>7.0.0</AssemblyVersion>
	</PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <FrameworkReference Include="Microsoft.Windows.SDK.NET.Ref" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250909003" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="ILNumerics.Computing" Version="7.4.16" />
    <PackageReference Include="ILNumerics.Drawing" Version="7.4.16" />
    <PackageReference Include="ILNumerics.Toolboxes.Drawing2" Version="7.4.16" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.31" />
    <PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="3.119.1" />
    <PackageReference Include="MinVer" Version="7.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
